# Ambiente de container para a API Java (Spring Boot)
FROM docker.io/library/eclipse-temurin:21-jdk-alpine

RUN apk add --no-cache maven

WORKDIR /app

# Porta padrão do Spring Boot
EXPOSE 8080

# Quando pom.xml existir em /app, executa a API Spring Boot conectada ao MongoDB
CMD ["sh", "-c", "if [ -f ./pom.xml ]; then apk add --no-cache maven >/dev/null 2>&1 || true; mvn spring-boot:run; else echo 'Ambiente Java 21 (ecommerce-api) pronto...'; tail -f /dev/null; fi"]
